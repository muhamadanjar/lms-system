# Application
PROJECT_NAME=LMS
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# Database
# Prefer DATABASE__URL for local development and CI.
# Supported schemes: postgresql://, sqlite:///, and mysql://.
DATABASE__URL=postgresql://lms_user:change-me@localhost:5432/lms

# Or configure the database components instead of DATABASE__URL:
# DATABASE__TYPE=postgresql
# DATABASE__HOST=localhost
# DATABASE__PORT=5432
# DATABASE__NAME=lms
# DATABASE__USER=lms_user
# DATABASE__PASSWORD=change-me

DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_RECYCLE=3600
DATABASE__POOL_TIMEOUT=30
DATABASE__CONNECT_TIMEOUT=10
DATABASE__DEBUG=false

# CORS accepts comma-separated values.
CORS__ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS__ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS__ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-Requested-With
CORS__ALLOW_CREDENTIALS=true

# User Management API authentication
USERMANAGEMENT__BASE_URL=http://localhost:8070
USERMANAGEMENT__AUTH_INFO_PATH=/auth/info
USERMANAGEMENT__TIMEOUT_SECONDS=3

# SSH console + credential encryption (required at startup).
# SSH_CREDENTIAL_ENC_KEY must be base64 of 32 random bytes. Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Never commit a real key; each environment uses its own value.
SSH_CREDENTIAL_ENC_KEY=change-me-generate-32-byte-base64-key
# SSH_CREDENTIAL_KEY_VERSION=1
# SSH_CONNECT_TIMEOUT=15
# SSH_AUTH_TIMEOUT=15
