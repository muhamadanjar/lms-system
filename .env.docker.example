# Copy to .env.docker. Never commit the copied file.
PROJECT_NAME=LMS
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
LMS_API_PORT=8000
LMS_DOCKER_ENV_FILE=.env.docker

# PostgreSQL runs on the Docker host, not in Compose.
DATABASE__URL=postgresql://lms_user:replace-me@host.docker.internal:5432/lms
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_RECYCLE=3600
DATABASE__POOL_TIMEOUT=30
DATABASE__CONNECT_TIMEOUT=10
DATABASE__DEBUG=false

FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_ROOT=var/private-files

CORS__ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS__ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS__ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-Requested-With
CORS__ALLOW_CREDENTIALS=true

USERMANAGEMENT__BASE_URL=http://host.docker.internal:8070
USERMANAGEMENT__AUTH_INFO_PATH=/auth/info
USERMANAGEMENT__TIMEOUT_SECONDS=3

# Required by the application. Generate a base64-encoded 32-byte value.
SSH_CREDENTIAL_ENC_KEY=replace-with-a-generated-key
